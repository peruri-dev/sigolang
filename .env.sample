ENV=dev
STARTUP_MESSAGE=true
JSON_LOG=false
PUBLISH_URL=http://localhost:3000
SERVICE_NAME=sigolang
HOST=0.0.0.0

#
#DATABASE_URI=file:./db/sigolang_dev.db?cache=shared
#
DATABASE_URI=postgresql://localhost/sigolang_dev?sslmode=disable
DATABASE_TIMEOUT=60
DATABASE_DEBUG=2
DATABASE_SLOG=true

CACHE_URI=redis://user:password@localhost:6379/0

# Inalog
INALOG_ACCESS_LOG=true
INALOG_ERROR_LOG=true
INALOG_PRINT_PAYLOAD=true
INALOG_LIMIT_PAYLOAD=1024

# Uptrace
UPTRACE_DISABLED=true
